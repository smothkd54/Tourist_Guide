# Pushkinskaya Street Explorer — Environment Configuration
# Copy to .env and edit for your deployment.

# CORS origins (pipe-delimited)
CORS_ORIGINS=http://localhost:*|http://127.0.0.1:*

# Gunicorn worker count (2x CPU cores is a good default)
GUNICORN_WORKERS=2

# Model path inside the container (TFLite, not Keras)
MODEL_PATH=/app/models/landmark_classifier.tflite

# Log directory inside the container
LOG_DIR=/app/logs

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by the compose `db` service and by alembic/seed_db.py.
# Generate a password with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=pushkinskaya
POSTGRES_USER=pushkinskaya
POSTGRES_PASSWORD=

# Host-side connection string, for running alembic/seed/tests outside Docker.
# docker-compose overrides this inside the web container with the `db` host.
DATABASE_URL=postgresql://pushkinskaya:CHANGE_ME@127.0.0.1:5432/pushkinskaya

# ── Tokens ───────────────────────────────────────────────────────────────────
# Required for docker compose: GET /metrics returns 401 unless the request
# carries this value in the X-Metrics-Token header. Caddy passes it through.
METRICS_TOKEN=

# Required for docker compose: /admin/* returns 401 without this value in
# the X-Admin-Token header, and 503 when the variable is unset.
ADMIN_TOKEN=
